{
  "name": "@dendreth/rollup",
  "version": "0.0.1",
  "keywords": [
    "rollup",
    "builder",
    "bundler",
    "bundle"
  ],
  "scripts": {
    "build:workspace": "yarn rollup-bundle $INIT_CWD",
    "build:recursive": "yarn workspaces foreach --from $0 -Rp --exclude '{.,@dendreth/rollup}' --topological-dev run build:workspace",
    "build:all": "yarn workspaces foreach --all -p --exclude '{.,@dendreth/rollup,circom}' --topological-dev run build:workspace"
  },
  "dependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/rollup-plugin-peer-deps-external": "^2",
    "glob": "^11.0.0",
    "rollup": "^4.20.0",
    "rollup-plugin-delete": "^2.0.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "tslib": "^2.8.1"
  },
  "bin": {
    "rollup-bundle": "bundle.mjs"
  }
}
